        "html.mc-mahjong-pdp-init:not(.mc-mahjong-pdp-ready) td.mc-pdp-options-td > #mc-pdp-description-below-features," +
        "html.mc-mahjong-pdp-init:not(.mc-mahjong-pdp-ready) #mc-pdp-accordion," +
