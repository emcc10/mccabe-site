        try { stripPriceZeroCents(); } catch (e) {}
        try { global.setTimeout(function () { stripPriceZeroCents(); }, 60); } catch (e) {}
        try { global.setTimeout(function () { stripPriceZeroCents(); }, 200); } catch (e) {}
        return r;
